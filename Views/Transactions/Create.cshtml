@model BudgetTracker.DataAccess.Transaction

@{
    ViewData["Title"] = "New Transaction";
}

<div class="page-header">
    <h1>New transaction</h1>
    <a asp-action="Index" class="btn btn-link">Back to ledger</a>
</div>

<div class="form-panel">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div>
                <label asp-for="TransactionDate" class="form-label">Date</label>
                <input asp-for="TransactionDate" class="form-control" type="date" />
                <span asp-validation-for="TransactionDate" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Amount" class="form-label">Amount</label>
                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="span-2">
                <label asp-for="Description" class="form-label">Description</label>
                <input asp-for="Description" class="form-control" placeholder="What was this for?" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="TransactionType" class="form-label">Type</label>
                <select asp-for="TransactionType" class="form-select">
                    <option value="Expense">Expense</option>
                    <option value="Income">Income</option>
                </select>
                <span asp-validation-for="TransactionType" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="CategoryId" class="form-label">Category</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-brand">Save transaction</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
